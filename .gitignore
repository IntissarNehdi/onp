backend/*.pyo
backend/*.pyd
backend/*.swp
backend/*.swo
backend/*.bak
backend/*.tmp

# Django-specific ignores
backend/*/migrations/
backend/db.sqlite3
backend/.env
backend/*.env
backend/.envrc
backend/.settings/
backend/media/
backend/staticfiles/
