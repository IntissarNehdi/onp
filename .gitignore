backend/*.sqlite3

# Docker-related ignores
.dockerignore
Dockerfile
docker-compose.yml
docker-compose.override.yml
backend/*.pid
/tmp/
backend/.docker/

# Coverage and testing
backend/.coverage
backend/*.cover
backend/coverage.xml
backend/nosetests.xml
backend/htmlcov/
