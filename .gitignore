backend/.vscode/
!.vscode/extensions.json
frontend/.idea/
backend/.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
/*.iml

# System files
.DS_Store
Thumbs.db
*.lnk

